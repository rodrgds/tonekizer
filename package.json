{
  "name": "tonekizer",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler pages dev dist --port 8788",
    "build": "vite build && esbuild src/worker.js --bundle --format=esm --platform=browser --minify --outfile=dist/_worker.js",
    "deploy": "npm run build && wrangler pages deploy dist --project-name=tonekizer",
    "test": "wrangler d1 execute tonekizer --local --command=\"DELETE FROM scores; DELETE FROM submission_limits;\" && node --test test/*.test.js",
    "db:local": "wrangler d1 migrations apply tonekizer --local",
    "db:remote": "wrangler d1 migrations apply tonekizer --remote"
  },
  "dependencies": {
    "@fontsource-variable/sora": "^5.3.0",
    "@fontsource/dm-sans": "^5.3.0",
    "gpt-tokenizer": "^3.4.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "vite": "^7.1.0",
    "wrangler": "^4.0.0"
  }
}
